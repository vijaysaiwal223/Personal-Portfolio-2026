# Your public website origin, e.g. https://your-domain.com.
# Vercel's production URL is used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=

# PostHog project token from your PostHog project settings.
# US ingestion is the default. Set NEXT_PUBLIC_POSTHOG_HOST to override it.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Server-only values for the public visitor total. Use a personal API key with
# project query read permission. Never prefix the key with NEXT_PUBLIC_.
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
# Use https://eu.posthog.com for an EU PostHog project.
POSTHOG_API_HOST=https://us.posthog.com
